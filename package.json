{
  "name": "historical-globe-electron",
  "version": "1.0.0",
  "private": true,
  "productName": "Chikyu-gata Rekishi Chizu",
  "description": "Local-first 3D historical globe map wrapped in Electron.",
  "repository": {
    "type": "git",
    "url": "https://github.com/irorinri/earth-history-globe.git"
  },
  "keywords": [
    "threejs",
    "historical-map",
    "geojson",
    "education",
    "electron"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.historical-globe-map",
    "artifactName": "historical-globe-map-${version}.${ext}",
    "asar": false,
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "data/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}
